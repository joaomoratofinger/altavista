rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador = existe um documento admins/{uid}. Só se cria pelo Console
    // do Firebase (nenhuma regra abaixo permite escrita em `admins`).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Cada usuário só consegue ler o próprio documento (para o painel saber se é admin).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Dados públicos do imóvel: visitantes só enxergam os publicados.
    match /properties/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();

      // Dados do proprietário, condições e anotações: SOMENTE admin.
      match /private/{doc} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
